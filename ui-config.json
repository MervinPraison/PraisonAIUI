eatures/layouts.md", "linkText": "Layouts"}, {"title": "Plugins", "icon": "plug", "details": "Add pages, settings sections, nav groups and themes from a Python package. React pages use the @aiui/sdk, so a plugin can do what a built-in page does.", "link": "features/plugins.md", "linkText": "UI plugins"}, {"title": "Docs sites", "icon": "book-open", "details": "One YAML file and a folder of Markdown become a searchable docs site with tabs, light and dark themes, SEO metadata and llms.txt. This site is built that way.", "link": "features/content-sources.md", "linkText": "Content sources"}, {"title": "Dashboard", "icon": "layout-dashboard", "details": "Sessions, agents, memory, knowledge, schedules, logs and usage pages out of the box, plus your own pages from @aiui.page with cards, tables and charts.", "link": "features/dashboard.md", "linkText": "Dashboard"}, {"title": "Auth and security", "icon": "shield-check", "details": "Sign-in, deny-by-default auth on every route and WebSocket, single-use WebSocket tickets, a cross-origin guard and a Host check for local servers.", "link": "features/deployment.md", "linkText": "Deployment and security"}]}, "navbar": {"primary": {"type": "button", "label": "Quick start", "href": "/docs/getting-started/quickstart"}, "links": [{"label": "Changelog", "href": "https://github.com/MervinPraison/PraisonAIUI/blob/main/CHANGELOG.md"}, {"label": "GitHub", "href": "https://github.com/MervinPraison/PraisonAIUI"}]}, "footer": {"socials": {"github": "https://github.com/MervinPraison/PraisonAIUI", "x": "https://x.com/MervinPraison", "youtube": "https://youtube.com/@MervinPraison"}, "links": [{"header": "PraisonAIUI", "items": [{"label": "GitHub", "href": "https://github.com/MervinPraison/PraisonAIUI"}, {"label": "PyPI", "href": "https://pypi.org/project/aiui/"}, {"label": "Changelog", "href": "https://github.com/MervinPraison/PraisonAIUI/blob/main/CHANGELOG.md"}]}, {"header": "PraisonAI", "items": [{"label": "PraisonAI docs", "href": "https://