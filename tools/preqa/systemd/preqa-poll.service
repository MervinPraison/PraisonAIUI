[Unit]
Description=PraisonAIUI pre-QA: rebuild on a new origin/main commit, then track

[Service]
Type=oneshot
WorkingDirectory=%h/preqa/tool
EnvironmentFile=-%h/preqa/env
Environment=AIUI_NO_BROWSER=1 BROWSER=true
ExecStart=%h/preqa/venv-tool/bin/python -m preqa poll --track
TimeoutStartSec=40min
SuccessExitStatus=1
