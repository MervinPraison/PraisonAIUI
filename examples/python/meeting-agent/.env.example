# Meeting Agent example — copy to .env and fill in. Never commit real secrets.

# Used by the PraisonAI agent for summarization/embeddings.
OPENAI_API_KEY=

# Optional: enable Slack summary delivery via the built-in SlackChannelAdapter.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Local dev server port for `python app.py`.
MEETING_AGENT_PORT=8000

# ── Recall.ai (EU workspace: Praison) ───────────────────────────────────────
# Region must match dashboard: eu-central-1 (Frankfurt).
RECALL_REGION=eu-central-1
RECALL_WORKSPACE_ID=33a035c7-03c1-4ec9-b752-18cdfbbefc42

# REST API key from Recall dashboard (Developers → API Keys). Server-side only.
RECALL_API_KEY=

# Workspace verification secret (whsec_…) from Recall MCP or dashboard.
RECALL_WEBHOOK_VERIFICATION_SECRET=

# Stable public HTTPS backend URL (reserved ngrok domain in dev). Required for
# webhooks and Google Calendar V2 OAuth callback forwarding.
PUBLIC_API_BASE_URL=

# Bot display name in meetings.
RECALL_BOT_NAME=Praison Meeting Agent

# Calendar V2: when true (default), eligible future events with video links get bots.
CALENDAR_AUTO_RECORD=true
