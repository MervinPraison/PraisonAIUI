{
  "name": "@praisonaiui/react",
  "version": "0.1.0",
  "private": true,
  "description": "The PraisonAIUI web UI (React shell, chat, docs): built into the Python package, not published to npm",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/prune-katex-fonts.mjs && node scripts/gen-externals.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:scripts": "node --test scripts/gates.test.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:baseline": "playwright test -c e2e/playwright.config.ts --project=legacy-baseline --update-snapshots=all",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "size": "size-limit",
    "sync": "node scripts/sync-templates.mjs",
    "check:bundle": "node scripts/check-bundle-sync.mjs",
    "check:closure": "node scripts/check-entry-closure.mjs"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "shadcn",
    "tailwindcss",
    "praisonai",
    "documentation"
  ],
  "author": "PraisonAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MervinPraison/PraisonAIUI.git",
    "directory": "src/frontend"
  },
  "peerDependencies": {
    "@a2ui/react": ">=0.10.0",
    "@a2ui/web_core": ">=0.10.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@a2ui/react": {
      "optional": true
    },
    "@a2ui/web_core": {
      "optional": true
    }
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.36",
    "@streamdown/math": "1.0.3",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "katex": "0.16.47",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.17.2",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "shiki": "4.6.0",
    "sonner": "2.0.8",
    "streamdown": "2.7.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@a2ui/react": "^0.10.0",
    "@a2ui/web_core": "^0.10.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.65.0",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "0.27.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "size-limit": "14.3.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
