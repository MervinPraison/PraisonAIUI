{
 "helpBanner": "\n    <div style=\"margin-bottom:20px;border:1px solid rgba(99,102,241,.2);border-radius:12px;background:rgba(99,102,241,.04);overflow:hidden\">\n      <div id=\"help-run-flight-recorder-toggle\" style=\"padding:12px 16px;cursor:pointer;display:flex;align-items:center;gap:8px;user-select:none\"\n           onclick=\"(function(el){var b=document.getElementById('help-run-flight-recorder-body');b.style.display=b.style.display==='none'?'block':'none';el.querySelector('.chevron').textContent=b.style.display==='none'?'▸':'▾'})(this)\">\n        <span class=\"chevron\" style=\"font-size:12px;color:var(--db-accent,#6366f1)\">▾</span>\n        <span style=\"font-size:13px;font-weight:600;color:var(--db-accent,#6366f1)\">ℹ️ About Run Flight Recorder</span>\n      </div>\n      <div id=\"help-run-flight-recorder-body\" style=\"padding:0 16px 14px;font-size:13px;line-height:1.8;color:var(--db-text-dim,#a1a1aa);display:block\">\n        <div style=\"margin-bottom:10px\">What it does.</div>\n        <div style=\"margin-bottom:10px\"><strong style=\"color:var(--db-text,#e4e4e7)\">How to use:</strong><br>Steps.</div>\n        <div style=\"padding:10px 14px;background:rgba(34,197,94,.06);border-radius:8px;border-left:3px solid rgba(34,197,94,.3)\"><strong style=\"color:#22c55e\">💡 Tip:</strong> A tip.</div>\n      </div>\n    </div>",
